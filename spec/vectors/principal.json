      ]
    },
    {
      "id": "principal_roles_rechecked_at_acceptance",
      "rules": ["MANDATE-PRINCIPAL-006"],
      "description": "A proposed address that became an agent or an executor after the proposal cannot accept until the role is removed.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": [],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "5000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "new_principal" },
          "expect": {
            "ok": true,
            "events": [
              { "name": "principal_proposed", "fields": { "current": "principal", "proposed": "new_principal" } }
            ]
          }
        },
        {
          "step": "call",
          "fn": "add_role",
          "caller": "principal",
          "args": { "role": 1, "account": "new_principal" },
          "expect": {
            "ok": true,
            "events": [{ "name": "role_added", "fields": { "role": 1, "account": "new_principal" } }]
          }
        },
        {
          "step": "call",
          "fn": "accept_principal",
          "caller": "new_principal",
          "expect": { "error": "ROLE_CONFLICT", "events": [] }
        },
        {
          "step": "call",
          "fn": "remove_role",
          "caller": "principal",
          "args": { "role": 1, "account": "new_principal" },
          "expect": {
            "ok": true,
            "events": [{ "name": "role_removed", "fields": { "role": 1, "account": "new_principal" } }]
          }
        },
        {
          "step": "call",
          "fn": "add_role",
          "caller": "principal",
          "args": { "role": 4, "account": "new_principal" },
          "expect": {
            "ok": true,
            "events": [{ "name": "role_added", "fields": { "role": 4, "account": "new_principal" } }]
          }
        },
        {
          "step": "call",
          "fn": "accept_principal",
          "caller": "new_principal",
          "expect": { "error": "ROLE_CONFLICT", "events": [] }
        },
        {
          "step": "call",
          "fn": "remove_role",
          "caller": "principal",
          "args": { "role": 4, "account": "new_principal" },
          "expect": {
            "ok": true,
            "events": [{ "name": "role_removed", "fields": { "role": 4, "account": "new_principal" } }]
          }
        },
        {
          "step": "call",
          "fn": "accept_principal",
          "caller": "new_principal",
          "expect": {
            "ok": true,
            "events": [
              { "name": "principal_transferred", "fields": { "previous": "principal", "current": "new_principal" } }
            ],
            "state": {
              "mandate": {
                "principal": "new_principal",
                "proposed_principal": null,
                "agents": ["agent"],
                "executors": []
              }
            }
          }
        }
      ]
    },
