{
  "format": "ujira-mandate-vectors/1",
  "description": "Principal transfer vectors: propose, accept and cancel, role conflicts at both steps, and how a pending change holds a third party's sweep.",
  "vectors": [
    {
      "id": "principal_two_step_transfer",
      "rules": [
        "MANDATE-PRINCIPAL-001",
        "MANDATE-PRINCIPAL-002",
        "MANDATE-PRINCIPAL-004",
        "MANDATE-PRINCIPAL-005",
        "MANDATE-PRINCIPAL-006"
      ],
      "description": "The principal proposes a new address, which accepts; the principal changes only then and the new one withdraws.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": [],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "5000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "new_principal" },
          "expect": {
            "ok": true,
            "events": [
              { "name": "principal_proposed", "fields": { "current": "principal", "proposed": "new_principal" } }
            ],
            "token_events": [],
            "state": { "mandate": { "principal": "principal", "proposed_principal": "new_principal" } }
          }
        },
        {
          "step": "call",
          "fn": "accept_principal",
          "caller": "new_principal",
          "expect": {
            "ok": true,
            "events": [
              { "name": "principal_transferred", "fields": { "previous": "principal", "current": "new_principal" } }
            ],
            "token_events": [],
            "state": { "mandate": { "principal": "new_principal", "proposed_principal": null } }
          }
        },
        {
          "step": "call",
          "fn": "withdraw",
          "caller": "new_principal",
          "args": { "amount": "100" },
          "expect": {
            "ok": true,
            "events": [{ "name": "withdrawn", "fields": { "to": "new_principal", "amount": "100" } }],
            "state": { "balances": { "asset": { "mandate": "4900", "principal": "0", "new_principal": "100" } } }
          }
        }
      ]
    },
    {
      "id": "principal_only_the_proposed_address_accepts",
      "rules": ["MANDATE-PRINCIPAL-002", "MANDATE-PRINCIPAL-004"],
      "description": "Only the proposed address can accept; afterwards the old principal's administrative calls are refused and the new one's work.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": [],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "5000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "new_principal" },
          "expect": {
            "ok": true,
            "events": [
              { "name": "principal_proposed", "fields": { "current": "principal", "proposed": "new_principal" } }
            ]
          }
        },
        {
          "step": "call",
          "fn": "accept_principal",
          "caller": "stranger",
          "expect": { "error": "UNAUTHORIZED", "events": [], "per_chain": { "stellar": { "host_auth_failure": true } } }
        },
        {
          "step": "call",
          "fn": "accept_principal",
          "caller": "principal",
          "expect": { "error": "UNAUTHORIZED", "events": [], "per_chain": { "stellar": { "host_auth_failure": true } } }
        },
        {
          "step": "call",
          "fn": "accept_principal",
          "caller": "agent",
          "expect": { "error": "UNAUTHORIZED", "events": [], "per_chain": { "stellar": { "host_auth_failure": true } } }
        },
        {
          "step": "call",
          "fn": "accept_principal",
          "caller": "new_principal",
          "expect": {
            "ok": true,
            "events": [
              { "name": "principal_transferred", "fields": { "previous": "principal", "current": "new_principal" } }
            ]
          }
        },
        {
          "step": "call",
          "fn": "update_limits",
          "caller": "principal",
          "args": {
            "limits": {
              "total_budget": "10000",
              "per_payment_cap": "1000",
              "per_recipient_daily_cap": "1000",
              "approval_threshold": "1001",
              "payout_ttl_seconds": "3600",
              "expires_at": "1798761600"
            }
          },
          "expect": { "error": "UNAUTHORIZED", "events": [], "per_chain": { "stellar": { "host_auth_failure": true } } }
        },
        {
          "step": "call",
          "fn": "update_limits",
          "caller": "new_principal",
          "args": {
            "limits": {
              "total_budget": "10000",
              "per_payment_cap": "1000",
              "per_recipient_daily_cap": "1000",
              "approval_threshold": "1001",
              "payout_ttl_seconds": "3600",
              "expires_at": "1798761600"
            }
          },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "limits_updated",
                "fields": {
                  "total_budget": "10000",
                  "per_payment_cap": "1000",
                  "per_recipient_daily_cap": "1000",
                  "approval_threshold": "1001",
                  "payout_ttl_seconds": "3600",
                  "expires_at": "1798761600"
                }
              }
            ],
            "state": {
              "mandate": {
                "principal": "new_principal",
                "limits": {
                  "total_budget": "10000",
                  "per_payment_cap": "1000",
                  "per_recipient_daily_cap": "1000",
                  "approval_threshold": "1001",
                  "payout_ttl_seconds": "3600",
                  "expires_at": "1798761600"
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "principal_accept_without_proposal_refused",
      "rules": ["MANDATE-PRINCIPAL-003", "MANDATE-PRINCIPAL-005"],
      "description": "accept_principal with no proposal is UNAUTHORIZED on every chain, before and after a proposal is cancelled.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": [],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "5000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "accept_principal",
          "caller": "new_principal",
          "expect": { "error": "UNAUTHORIZED", "events": [] }
        },
        {
          "step": "call",
          "fn": "accept_principal",
          "caller": "principal",
          "expect": { "error": "UNAUTHORIZED", "events": [] }
        },
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "new_principal" },
          "expect": {
            "ok": true,
            "events": [
              { "name": "principal_proposed", "fields": { "current": "principal", "proposed": "new_principal" } }
            ]
          }
        },
        {
          "step": "call",
          "fn": "cancel_principal_proposal",
          "caller": "principal",
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "principal_proposal_cancelled",
                "fields": { "current": "principal", "proposed": "new_principal" }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "accept_principal",
          "caller": "new_principal",
          "expect": { "error": "UNAUTHORIZED", "events": [] }
        },
        {
          "step": "call",
          "fn": "state",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": {
              "spent": "0",
              "pending": "0",
              "committed": "0",
              "balance": "5000",
              "free": "5000",
              "paused": false,
              "revoked": false,
              "expired": false,
              "policy_epoch": "0"
            },
            "events": [],
            "state": { "mandate": { "principal": "principal", "proposed_principal": null } }
          }
        }
      ]
    },
    {
      "id": "principal_proposal_role_conflicts",
      "rules": ["MANDATE-PRINCIPAL-001", "MANDATE-ROLE-008"],
      "description": "An agent, executor, recovery approver or the fee address cannot be proposed; an approver or a guardian can.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": ["approver"],
          "approvals_required": 1,
          "guardians": ["guardian"],
          "executors": ["executor"],
          "recovery": ["rescuer"],
          "recovery_threshold": 1,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "500",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "5000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "agent" },
          "expect": { "error": "ROLE_CONFLICT", "events": [] }
        },
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "executor" },
          "expect": { "error": "ROLE_CONFLICT", "events": [] }
        },
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "rescuer" },
          "expect": { "error": "ROLE_CONFLICT", "events": [] }
        },
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "fee_address" },
          "expect": { "error": "ROLE_CONFLICT", "events": [] }
        },
        {
          "step": "call",
          "fn": "state",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": {
              "spent": "0",
              "pending": "0",
              "committed": "0",
              "balance": "5000",
              "free": "5000",
              "paused": false,
              "revoked": false,
              "expired": false,
              "policy_epoch": "0"
            },
            "events": [],
            "state": { "mandate": { "proposed_principal": null } }
          }
        },
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "approver" },
          "expect": {
            "ok": true,
            "events": [{ "name": "principal_proposed", "fields": { "current": "principal", "proposed": "approver" } }],
            "state": { "mandate": { "proposed_principal": "approver" } }
          }
        },
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "guardian" },
          "expect": {
            "ok": true,
            "events": [{ "name": "principal_proposed", "fields": { "current": "principal", "proposed": "guardian" } }],
            "state": { "mandate": { "proposed_principal": "guardian" } }
          }
        }
      ]
    },
    {
      "id": "principal_new_proposal_replaces_earlier",
