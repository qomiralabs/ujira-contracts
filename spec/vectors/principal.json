          "caller": "principal",
          "args": { "proposed": "successor_a" },
          "expect": {
            "ok": true,
            "events": [
              { "name": "principal_proposed", "fields": { "current": "principal", "proposed": "successor_a" } }
            ]
          }
        },
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "successor_b" },
          "expect": {
            "ok": true,
            "events": [
              { "name": "principal_proposed", "fields": { "current": "principal", "proposed": "successor_b" } }
