          },
          "expect": {
            "ok": true,
            "return": "APPROVED",
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p1",
                  "agent": "agent",
                  "recipient_ref": "#bob",
                  "total": "400",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "400" }],
                  "task_ref": "#task_p1",
                  "status": "APPROVED",
                  "expires_at": "1767312000"
