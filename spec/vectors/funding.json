            "req": {
              "payout_id": "#p1",
              "recipient_ref": "#bob",
              "total": "400",
              "fee": "0",
              "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "400" }],
              "deadline": "1767226200",
              "task_ref": "#task_p1",
              "attestations": []
