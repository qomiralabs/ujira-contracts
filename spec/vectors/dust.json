{
  "format": "ujira-mandate-vectors/1",
  "description": "One minor unit and many tiny deposits are part of the balance and change no limit result.",
  "vectors": [
    {
      "id": "dust_one_unit_is_spendable",
      "rules": ["MANDATE-DUST-001", "MANDATE-FUND-001"],
      "description": "A deposit of one minor unit is the whole balance, and a one unit payout spends it.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": ["guardian"],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [{ "token": "asset", "to": "principal", "amount": "1" }]
      },
      "steps": [
        {
          "step": "transfer",
          "token": "asset",
          "from": "principal",
          "to": "mandate",
          "amount": "1",
          "events": []
        },
        {
          "step": "call",
          "fn": "state",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": {
              "spent": "0",
              "pending": "0",
              "committed": "0",
              "balance": "1",
              "free": "1",
              "paused": false,
              "revoked": false,
              "expired": false,
              "policy_epoch": "0"
            },
            "events": []
          }
        },
        {
          "step": "call",
          "fn": "request_payout",
          "caller": "agent",
          "args": {
            "req": {
              "payout_id": "#p1",
              "recipient_ref": "#bob",
              "total": "1",
              "fee": "0",
              "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "1" }],
              "deadline": "1767226200",
              "task_ref": "#task_p1",
              "attestations": []
            }
          },
          "expect": {
            "ok": true,
            "return": "APPROVED",
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p1",
                  "agent": "agent",
                  "recipient_ref": "#bob",
                  "total": "1",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "1" }],
                  "task_ref": "#task_p1",
                  "status": "APPROVED",
                  "expires_at": "1767312000"
                }
              }
            ],
            "state": {
              "mandate": { "spent": "0", "pending": "0", "committed": "1", "balance": "1", "free": "0" }
            }
          }
        },
        {
          "step": "call",
          "fn": "execute",
          "caller": "agent",
          "args": { "payout_id": "#p1" },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "payout_executed",
                "fields": {
                  "payout_id": "#p1",
                  "recipient_ref": "#bob",
                  "total": "1",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "1" }],
                  "day": "20454",
                  "spent": "1"
                }
              }
            ],
            "state": {
              "mandate": { "spent": "1", "pending": "0", "committed": "0", "balance": "0", "free": "0" },
              "balances": { "asset": { "mandate": "0", "bob": "1" } }
            }
          }
        }
      ]
    },
