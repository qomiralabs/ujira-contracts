            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p1",
                  "agent": "agent",
                  "recipient_ref": "#bob",
                  "total": "600",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
                  "task_ref": "#task_p1",
