                  "per_recipient_daily_cap": "1000",
                  "approval_threshold": "1001",
                  "payout_ttl_seconds": "7200",
                  "expires_at": "1798761600"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "remove_role",
          "caller": "principal",
          "args": { "role": 2, "account": "approver" },
          "expect": {
            "ok": true,
            "events": [
              { "name": "role_removed", "fields": { "role": 2, "account": "approver" } },
              { "name": "approvals_required_set", "fields": { "required": 0 } }
            ]
          }
        },
        {
          "step": "call",
          "fn": "add_role",
          "caller": "principal",
          "args": { "role": 3, "account": "guardian" },
          "expect": {
            "ok": true,
            "events": [{ "name": "role_added", "fields": { "role": 3, "account": "guardian" } }]
          }
        },
        {
          "step": "call",
          "fn": "add_role",
          "caller": "principal",
          "args": { "role": 1, "account": "agent2" },
          "expect": {
            "ok": true,
            "events": [{ "name": "role_added", "fields": { "role": 1, "account": "agent2" } }]
          }
        },
        {
          "step": "call",
          "fn": "add_role",
          "caller": "principal",
          "args": { "role": 4, "account": "executor" },
          "expect": {
            "ok": true,
            "events": [{ "name": "role_added", "fields": { "role": 4, "account": "executor" } }]
          }
        },
        {
          "step": "call",
          "fn": "remove_role",
          "caller": "principal",
          "args": { "role": 1, "account": "agent2" },
          "expect": {
            "ok": true,
            "events": [{ "name": "role_removed", "fields": { "role": 1, "account": "agent2" } }]
          }
        },
        {
          "step": "call",
          "fn": "set_recovery_threshold",
          "caller": "principal",
          "args": { "n": 0 },
          "expect": {
            "ok": true,
            "events": [{ "name": "recovery_threshold_set", "fields": { "required": 0, "recovery_epoch": 3 } }]
          }
        },
        {
          "step": "call",
          "fn": "allow_recipients",
          "caller": "principal",
          "args": {
            "entries": [
              { "recipient_ref": "#carol", "destination": { "address": "carol", "tag": null } },
              { "recipient_ref": "#dave", "destination": { "address": "dave", "tag": null } }
            ]
          },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "recipient_allowed",
                "fields": { "recipient_ref": "#carol", "destination": { "address": "carol", "tag": null } }
              },
              {
                "name": "recipient_allowed",
                "fields": { "recipient_ref": "#dave", "destination": { "address": "dave", "tag": null } }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "disallow_recipients",
          "caller": "principal",
          "args": { "entries": [{ "recipient_ref": "#carol", "destination": { "address": "carol", "tag": null } }] },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "recipient_disallowed",
                "fields": { "recipient_ref": "#carol", "destination": { "address": "carol", "tag": null } }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "pause",
          "caller": "guardian",
          "expect": {
            "ok": true,
            "events": [{ "name": "paused", "fields": { "by": "guardian" } }]
          }
        },
        {
          "step": "call",
          "fn": "resume",
          "caller": "principal",
          "expect": {
            "ok": true,
            "events": [{ "name": "resumed", "fields": { "by": "principal" } }]
          }
        },
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "new_principal" },
          "expect": {
            "ok": true,
            "events": [
              { "name": "principal_proposed", "fields": { "current": "principal", "proposed": "new_principal" } }
            ]
          }
        },
        {
          "step": "call",
          "fn": "cancel_principal_proposal",
          "caller": "principal",
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "principal_proposal_cancelled",
                "fields": { "current": "principal", "proposed": "new_principal" }
              }
            ],
            "state": {
              "mandate": {
                "approvers": [],
                "approvals_required": 0,
                "guardians": ["guardian"],
                "executors": ["executor"],
                "agents": ["agent"],
                "recovery_epoch": 3,
                "agent_epoch": 1
              }
            }
          }
        }
      ]
