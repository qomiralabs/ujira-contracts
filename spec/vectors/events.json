              { "name": "approvals_required_set", "fields": { "required": 1 } }
            ],
            "token_events": []
          }
        },
        {
          "step": "call",
          "fn": "add_role",
          "caller": "principal",
          "args": { "role": 2, "account": "approver2" },
          "expect": {
            "ok": true,
            "events": [{ "name": "role_added", "fields": { "role": 2, "account": "approver2" } }]
          }
        },
        {
          "step": "call",
          "fn": "set_approvals_required",
          "caller": "principal",
          "args": { "n": 2 },
          "expect": {
            "ok": true,
            "events": [{ "name": "approvals_required_set", "fields": { "required": 2 } }]
          }
        },
        {
          "step": "call",
          "fn": "set_approvals_required",
          "caller": "principal",
          "args": { "n": 1 },
          "expect": {
            "ok": true,
            "events": [{ "name": "approvals_required_set", "fields": { "required": 1 } }]
          }
        },
        {
          "step": "call",
          "fn": "remove_role",
