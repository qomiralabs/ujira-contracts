{
  "format": "ujira-mandate-vectors/1",
  "description": "Event vectors: each successful operation emits exactly its events in order and in canonical form, refused calls emit nothing, and funding emits no mandate event.",
  "vectors": [
    {
      "id": "events_payout_flow_in_order",
      "rules": ["MANDATE-EVENT-001", "MANDATE-EVENT-002"],
      "description": "Each payout operation emits exactly its events in order: request, approval, execute, reject, cancel and the batches.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_tag": "#tenant",
          "agents": ["agent"],
          "approvers": ["approver"],
          "approvals_required": 1,
          "guardians": [],
          "executors": ["executor"],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "500",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [
          { "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } },
          { "recipient_ref": "#carol", "destination": { "address": "carol", "tag": null } }
        ],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "5000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "request_payout",
          "caller": "agent",
          "args": {
            "req": {
              "payout_id": "#p1",
              "recipient_ref": "#bob",
              "total": "600",
              "fee": "0",
              "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
              "deadline": "1767226200",
              "task_ref": "#task_p1",
              "attestations": []
            }
          },
          "expect": {
            "ok": true,
            "return": "PENDING",
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p1",
                  "agent": "agent",
                  "recipient_ref": "#bob",
                  "total": "600",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
                  "task_ref": "#task_p1",
                  "status": "PENDING",
                  "expires_at": "1767312000"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "approve",
          "caller": "approver",
          "args": { "payout_id": "#p1" },
          "expect": {
            "ok": true,
            "return": "APPROVED",
            "events": [
              {
                "name": "payout_approval_added",
                "fields": { "payout_id": "#p1", "approver": "approver", "approvals": 1, "required": 1 }
              },
              { "name": "payout_approved", "fields": { "payout_id": "#p1" } }
            ]
          }
        },
        {
          "step": "call",
          "fn": "execute",
          "caller": "executor",
          "args": { "payout_id": "#p1" },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "payout_executed",
                "fields": {
                  "payout_id": "#p1",
                  "recipient_ref": "#bob",
                  "total": "600",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
                  "day": "20454",
                  "spent": "600"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "request_payout",
          "caller": "agent",
          "args": {
            "req": {
              "payout_id": "#p2",
              "recipient_ref": "#carol",
              "total": "700",
              "fee": "0",
              "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "700" }],
              "deadline": "1767226200",
              "task_ref": "#task_p2",
              "attestations": []
            }
          },
          "expect": {
            "ok": true,
            "return": "PENDING",
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p2",
                  "agent": "agent",
                  "recipient_ref": "#carol",
                  "total": "700",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "700" }],
                  "task_ref": "#task_p2",
                  "status": "PENDING",
                  "expires_at": "1767312000"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "reject",
          "caller": "principal",
          "args": { "payout_id": "#p2" },
          "expect": {
            "ok": true,
            "events": [{ "name": "payout_rejected", "fields": { "payout_id": "#p2", "by": "principal" } }]
          }
        },
        {
          "step": "call",
          "fn": "request_payout",
          "caller": "agent",
          "args": {
            "req": {
              "payout_id": "#p3",
              "recipient_ref": "#bob",
              "total": "100",
              "fee": "0",
              "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "100" }],
              "deadline": "1767226200",
              "task_ref": "#task_p3",
              "attestations": []
            }
          },
          "expect": {
            "ok": true,
            "return": "APPROVED",
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p3",
                  "agent": "agent",
                  "recipient_ref": "#bob",
                  "total": "100",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "100" }],
                  "task_ref": "#task_p3",
                  "status": "APPROVED",
                  "expires_at": "1767312000"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "cancel",
          "caller": "agent",
          "args": { "payout_id": "#p3" },
          "expect": {
            "ok": true,
            "events": [{ "name": "payout_cancelled", "fields": { "payout_id": "#p3", "by": "agent", "reason": 2 } }]
          }
        },
        {
          "step": "call",
          "fn": "request_payouts",
          "caller": "agent",
          "args": {
            "reqs": [
              {
                "payout_id": "#p4",
                "recipient_ref": "#carol",
                "total": "100",
                "fee": "0",
                "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "100" }],
                "deadline": "1767226200",
                "task_ref": "#task_p4",
                "attestations": []
              },
              {
                "payout_id": "#p5",
                "recipient_ref": "#bob",
                "total": "200",
                "fee": "0",
                "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "200" }],
                "deadline": "1767226200",
                "task_ref": "#task_p5",
                "attestations": []
              },
              {
                "payout_id": "#p6",
                "recipient_ref": "#bob",
                "total": "300",
                "fee": "0",
                "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "300" }],
                "deadline": "1767226200",
                "task_ref": "#task_p6",
                "attestations": []
              }
            ]
          },
          "expect": {
            "ok": true,
            "return": [
              { "payout_id": "#p4", "code": 0, "status": "APPROVED" },
              { "payout_id": "#p5", "code": 0, "status": "APPROVED" },
              { "payout_id": "#p6", "code": 0, "status": "APPROVED" }
            ],
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p4",
                  "agent": "agent",
                  "recipient_ref": "#carol",
                  "total": "100",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "100" }],
                  "task_ref": "#task_p4",
                  "status": "APPROVED",
                  "expires_at": "1767312000"
                }
              },
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p5",
                  "agent": "agent",
                  "recipient_ref": "#bob",
                  "total": "200",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "200" }],
                  "task_ref": "#task_p5",
                  "status": "APPROVED",
                  "expires_at": "1767312000"
                }
              },
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p6",
                  "agent": "agent",
                  "recipient_ref": "#bob",
                  "total": "300",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "300" }],
                  "task_ref": "#task_p6",
                  "status": "APPROVED",
                  "expires_at": "1767312000"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "execute_batch",
          "caller": "agent",
          "args": { "ids": ["#p4", "#p5"] },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "payout_executed",
                "fields": {
                  "payout_id": "#p4",
                  "recipient_ref": "#carol",
                  "total": "100",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "100" }],
                  "day": "20454",
                  "spent": "700"
                }
              },
              {
                "name": "payout_executed",
                "fields": {
                  "payout_id": "#p5",
                  "recipient_ref": "#bob",
                  "total": "200",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "200" }],
                  "day": "20454",
                  "spent": "900"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "cancel_batch",
          "caller": "principal",
          "args": { "ids": ["#p6"] },
          "expect": {
            "ok": true,
            "return": [{ "payout_id": "#p6", "code": 0, "status": "CANCELLED" }],
            "events": [
              { "name": "payout_cancelled", "fields": { "payout_id": "#p6", "by": "principal", "reason": 1 } }
            ],
            "state": { "mandate": { "spent": "900", "pending": "0", "committed": "0" } }
          }
        }
      ]
    },
    {
      "id": "events_configuration_calls_in_order",
      "rules": ["MANDATE-EVENT-001", "MANDATE-EVENT-002"],
      "description": "Each configuration call emits exactly its events in order, including approvals_required_set after the first and last approver change.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_tag": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": [],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "5000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "add_role",
