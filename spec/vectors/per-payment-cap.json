{
  "format": "ujira-mandate-vectors/1",
  "description": "Per-payment cap vectors: the cap met exactly and by one unit over, and re-checked at execute after the principal lowers it.",
  "vectors": [
    {
      "id": "payment_cap_exact_accepted",
      "rules": ["MANDATE-PAYMENT-001", "MANDATE-PAYMENT-002"],
      "description": "A charge equal to the per-payment cap of 600 is allowed at request and at execute.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_tag": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": [],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "600",
            "per_recipient_daily_cap": "10000",
            "approval_threshold": "601",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "10000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "request_payout",
          "caller": "agent",
          "args": {
            "req": {
              "payout_id": "#p1",
              "recipient_ref": "#bob",
              "total": "600",
              "fee": "0",
              "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
              "deadline": "1767226200",
              "task_ref": "#task1",
              "attestations": []
            }
          },
          "expect": {
            "ok": true,
            "return": "APPROVED",
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p1",
                  "agent": "agent",
                  "recipient_ref": "#bob",
                  "total": "600",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
                  "task_ref": "#task1",
                  "status": "APPROVED",
                  "expires_at": "1767312000"
                }
              }
            ],
            "state": {
              "mandate": { "spent": "0", "pending": "0", "committed": "600", "balance": "10000", "free": "9400" },
              "payouts": {
                "#p1": {
                  "status": "APPROVED",
                  "total": "600",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
                  "created_at": "1767225600",
                  "expires_at": "1767312000"
                }
              }
            }
          }
        },
        {
          "step": "call",
          "fn": "execute",
          "caller": "agent",
          "args": { "payout_id": "#p1" },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "payout_executed",
                "fields": {
                  "payout_id": "#p1",
                  "recipient_ref": "#bob",
                  "total": "600",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
                  "day": "20454",
                  "spent": "600"
                }
              }
            ],
            "state": {
              "mandate": { "spent": "600", "pending": "0", "committed": "0", "balance": "9400", "free": "9400" },
              "payouts": { "#p1": { "status": "EXECUTED" } },
              "daily": { "#bob": { "day": "20454", "used": "600" } },
              "balances": { "asset": { "mandate": "9400", "bob": "600" } }
            }
          }
        }
      ]
    },
