{
  "format": "ujira-mandate-vectors/1",
  "description": "Tokens other than the settlement asset are never counted or paid out by an agent and only the principal recovers them; the factory's supported asset at creation.",
  "vectors": [
    {
      "id": "other_token_is_never_counted",
      "rules": ["MANDATE-ASSET-002", "MANDATE-FUND-001", "MANDATE-RECOVER-003"],
      "description": "A transfer of another token is not in the balance or the free funds, and the principal recovers all of it.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": ["guardian"],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [
          { "token": "asset", "to": "mandate", "amount": "500" },
          { "token": "other_token", "to": "stranger", "amount": "700" }
        ]
      },
      "steps": [
        {
          "step": "transfer",
          "token": "other_token",
          "from": "stranger",
          "to": "mandate",
          "amount": "700",
          "events": []
        },
        {
          "step": "call",
          "fn": "state",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": {
              "spent": "0",
              "pending": "0",
              "committed": "0",
              "balance": "500",
              "free": "500",
              "paused": false,
              "revoked": false,
              "expired": false,
              "policy_epoch": "0"
            },
            "events": []
          }
        },
        {
          "step": "call",
          "fn": "request_payout",
          "caller": "agent",
          "args": {
            "req": {
              "payout_id": "#p1",
              "recipient_ref": "#bob",
              "total": "500",
              "fee": "0",
              "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "500" }],
              "deadline": "1767226200",
              "task_ref": "#task_p1",
              "attestations": []
            }
          },
          "expect": {
            "ok": true,
            "return": "APPROVED",
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p1",
                  "agent": "agent",
                  "recipient_ref": "#bob",
                  "total": "500",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "500" }],
                  "task_ref": "#task_p1",
                  "status": "APPROVED",
                  "expires_at": "1767312000"
                }
              }
            ],
            "state": {
              "mandate": { "spent": "0", "pending": "0", "committed": "500", "balance": "500", "free": "0" }
            }
          }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "other_token", "amount": "700" },
          "expect": {
            "ok": true,
            "events": [{ "name": "token_recovered", "fields": { "token": "other_token", "amount": "700" } }],
            "state": {
              "mandate": { "balance": "500", "committed": "500", "free": "0" },
              "balances": {
                "other_token": { "mandate": "0", "principal": "700", "stranger": "0" },
                "asset": { "mandate": "500", "principal": "0" }
              }
            }
          }
        },
        {
          "step": "call",
          "fn": "execute",
          "caller": "agent",
          "args": { "payout_id": "#p1" },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "payout_executed",
                "fields": {
                  "payout_id": "#p1",
                  "recipient_ref": "#bob",
                  "total": "500",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "500" }],
                  "day": "20454",
                  "spent": "500"
                }
              }
            ],
            "state": {
              "mandate": { "spent": "500", "pending": "0", "committed": "0", "balance": "0", "free": "0" },
              "balances": { "asset": { "mandate": "0", "bob": "500" } }
            }
          }
        }
      ]
    },
