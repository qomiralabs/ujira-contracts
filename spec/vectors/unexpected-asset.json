            }
          }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "agent",
          "args": { "token": "other_token", "amount": "1000" },
          "expect": {
            "error": "UNAUTHORIZED",
            "events": [],
            "per_chain": { "stellar": { "host_auth_failure": true } }
          }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "guardian",
          "args": { "token": "other_token", "amount": "1000" },
          "expect": {
            "error": "UNAUTHORIZED",
            "events": [],
            "per_chain": { "stellar": { "host_auth_failure": true } }
          }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "stranger",
          "args": { "token": "other_token", "amount": "1000" },
          "expect": {
            "error": "UNAUTHORIZED",
            "events": [],
            "per_chain": { "stellar": { "host_auth_failure": true } }
          }
        },
        {
          "step": "call",
          "fn": "recover_token",
