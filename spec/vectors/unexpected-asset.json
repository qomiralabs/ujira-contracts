        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "1000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "asset", "amount": "1" },
          "expect": { "error": "WRONG_ASSET", "events": [] }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "asset", "amount": "1000" },
          "expect": { "error": "WRONG_ASSET", "events": [] }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "asset", "amount": "0" },
          "expect": { "error": "WRONG_ASSET", "events": [] }
        },
        {
          "step": "call",
          "fn": "state",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": {
              "spent": "0",
              "pending": "0",
              "committed": "0",
              "balance": "1000",
              "free": "1000",
              "paused": false,
              "revoked": false,
              "expired": false,
              "policy_epoch": "0"
            },
            "events": [],
            "state": { "balances": { "asset": { "mandate": "1000", "principal": "0" } } }
          }
        },
        {
          "step": "call",
          "fn": "withdraw",
          "caller": "principal",
          "args": { "amount": "1000" },
          "expect": {
            "ok": true,
            "events": [{ "name": "withdrawn", "fields": { "to": "principal", "amount": "1000" } }],
            "state": { "balances": { "asset": { "mandate": "0", "principal": "1000" } } }
          }
        }
      ]
    },
