{
  "format": "ujira-mandate-vectors/1",
  "description": "Withdraw is capped at free while active, takes the whole balance once closed and pays only the principal; and the sweep grace boundary.",
  "vectors": [
    {
      "id": "withdraw_capped_at_free_while_active",
      "rules": ["MANDATE-WITHDRAW-001", "MANDATE-WITHDRAW-003", "MANDATE-WITHDRAW-004"],
      "description": "With a pending and a committed payout, withdrawing free plus one is refused, exactly free succeeds, and both payouts still execute.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": ["approver"],
          "approvals_required": 1,
          "guardians": ["guardian"],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "500",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [
          { "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } },
          { "recipient_ref": "#carol", "destination": { "address": "carol", "tag": null } }
        ],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "1000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "request_payout",
          "caller": "agent",
          "args": {
            "req": {
              "payout_id": "#p1",
              "recipient_ref": "#bob",
              "total": "600",
              "fee": "0",
              "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
              "deadline": "1767226200",
              "task_ref": "#task_p1",
              "attestations": []
            }
          },
          "expect": {
            "ok": true,
            "return": "PENDING",
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p1",
                  "agent": "agent",
                  "recipient_ref": "#bob",
                  "total": "600",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
                  "task_ref": "#task_p1",
                  "status": "PENDING",
                  "expires_at": "1767312000"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "request_payout",
          "caller": "agent",
          "args": {
            "req": {
              "payout_id": "#p2",
              "recipient_ref": "#carol",
              "total": "300",
              "fee": "0",
              "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "300" }],
              "deadline": "1767226200",
              "task_ref": "#task_p2",
              "attestations": []
            }
          },
          "expect": {
            "ok": true,
            "return": "APPROVED",
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p2",
                  "agent": "agent",
                  "recipient_ref": "#carol",
                  "total": "300",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "300" }],
                  "task_ref": "#task_p2",
                  "status": "APPROVED",
                  "expires_at": "1767312000"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "state",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": {
              "spent": "0",
              "pending": "600",
              "committed": "300",
              "balance": "1000",
              "free": "100",
              "paused": false,
              "revoked": false,
              "expired": false,
              "policy_epoch": "0"
            },
            "events": []
          }
        },
        {
          "step": "call",
          "fn": "withdraw",
          "caller": "principal",
          "args": { "amount": "101" },
          "expect": { "error": "INSUFFICIENT_FUNDS", "events": [] }
        },
        {
          "step": "call",
          "fn": "withdraw",
          "caller": "principal",
          "args": { "amount": "100" },
          "expect": {
            "ok": true,
            "events": [{ "name": "withdrawn", "fields": { "to": "principal", "amount": "100" } }],
            "state": {
              "mandate": {
                "spent": "0",
                "pending": "600",
                "committed": "300",
                "balance": "900",
                "free": "0"
              },
              "balances": { "asset": { "mandate": "900", "principal": "100" } }
            }
          }
        },
        {
          "step": "call",
          "fn": "withdraw",
          "caller": "principal",
          "args": { "amount": "1" },
          "expect": { "error": "INSUFFICIENT_FUNDS", "events": [] }
        },
        {
          "step": "call",
          "fn": "approve",
          "caller": "approver",
          "args": { "payout_id": "#p1" },
          "expect": {
            "ok": true,
            "return": "APPROVED",
            "events": [
              {
                "name": "payout_approval_added",
                "fields": { "payout_id": "#p1", "approver": "approver", "approvals": 1, "required": 1 }
              },
              { "name": "payout_approved", "fields": { "payout_id": "#p1" } }
            ]
          }
        },
        {
          "step": "call",
          "fn": "execute",
          "caller": "agent",
          "args": { "payout_id": "#p1" },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "payout_executed",
                "fields": {
                  "payout_id": "#p1",
                  "recipient_ref": "#bob",
                  "total": "600",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
                  "day": "20454",
                  "spent": "600"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "execute",
          "caller": "agent",
          "args": { "payout_id": "#p2" },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "payout_executed",
                "fields": {
                  "payout_id": "#p2",
                  "recipient_ref": "#carol",
                  "total": "300",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "300" }],
                  "day": "20454",
                  "spent": "900"
                }
              }
            ],
            "state": {
              "mandate": { "spent": "900", "pending": "0", "committed": "0", "balance": "0", "free": "0" },
              "balances": { "asset": { "mandate": "0", "principal": "100", "bob": "600", "carol": "300" } }
            }
          }
        }
      ]
    },
