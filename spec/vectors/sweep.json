    {
      "id": "sweep_held_while_a_principal_change_is_pending",
      "rules": ["MANDATE-SWEEP-002", "MANDATE-SWEEP-003", "MANDATE-PRINCIPAL-003"],
      "description": "A proposed principal change holds every third-party sweep, within the grace and after it, until the proposal is cancelled.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_tag": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": ["guardian"],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1767312000"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "1000" }]
      },
      "steps": [
        { "step": "set_time", "now": "1767312000" },
        {
          "step": "call",
          "fn": "propose_principal",
          "caller": "principal",
          "args": { "proposed": "principal2" },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "principal_proposed",
                "fields": { "current": "principal", "proposed": "principal2" }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "sweep",
          "caller": "stranger",
          "expect": { "error": "PRINCIPAL_CHANGE_PENDING", "events": [] }
        },
        { "step": "set_time", "now": "1769904000" },
        {
          "step": "call",
          "fn": "sweep",
          "caller": "stranger",
          "expect": { "error": "PRINCIPAL_CHANGE_PENDING", "events": [] }
        },
        {
          "step": "call",
          "fn": "cancel_principal_proposal",
          "caller": "principal",
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "principal_proposal_cancelled",
                "fields": { "current": "principal", "proposed": "principal2" }
              }
            ],
            "state": { "mandate": { "proposed_principal": null } }
          }
        },
        {
          "step": "call",
          "fn": "sweep",
          "caller": "stranger",
          "expect": {
            "ok": true,
            "return": "1000",
            "events": [{ "name": "swept", "fields": { "by": "stranger", "amount": "1000" } }],
            "state": {
              "balances": {
                "asset": { "mandate": "0", "principal": "1000", "principal2": "0", "stranger": "0" }
              }
            }
          }
        }
      ]
    },
