{
  "format": "ujira-mandate-vectors/1",
  "description": "Sweep needs a closed mandate and a balance, pays only the principal, and respects the principal change and grace guards.",
  "vectors": [
    {
      "id": "sweep_of_an_active_mandate_refused",
      "rules": ["MANDATE-SWEEP-001", "MANDATE-SWEEP-004"],
      "description": "An active mandate cannot be swept by anyone, empty or funded, paused or not.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_tag": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": ["guardian"],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [{ "token": "asset", "to": "funder", "amount": "1000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "sweep",
          "caller": "principal",
          "expect": { "error": "MANDATE_ACTIVE", "events": [] }
        },
        {
          "step": "call",
          "fn": "sweep",
          "caller": "stranger",
          "expect": { "error": "MANDATE_ACTIVE", "events": [] }
        },
        {
          "step": "transfer",
          "token": "asset",
          "from": "funder",
          "to": "mandate",
          "amount": "1000",
          "events": []
        },
        {
          "step": "call",
          "fn": "sweep",
          "caller": "stranger",
          "expect": { "error": "MANDATE_ACTIVE", "events": [] }
        },
        {
          "step": "call",
          "fn": "pause",
          "caller": "guardian",
          "expect": { "ok": true, "events": [{ "name": "paused", "fields": { "by": "guardian" } }] }
        },
        {
          "step": "call",
          "fn": "sweep",
          "caller": "principal",
          "expect": { "error": "MANDATE_ACTIVE", "events": [] }
        },
        {
          "step": "call",
          "fn": "sweep",
          "caller": "stranger",
          "expect": { "error": "MANDATE_ACTIVE", "events": [] }
        },
        {
          "step": "call",
          "fn": "state",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": {
              "spent": "0",
              "pending": "0",
              "committed": "0",
              "balance": "1000",
              "free": "1000",
              "paused": true,
              "revoked": false,
              "expired": false,
              "policy_epoch": "0"
            },
            "events": []
          }
        }
      ]
    },
