{
  "format": "ujira-mandate-vectors/1",
  "description": "Pause blocks requests, approvals and execution only, and who may pause and resume.",
  "vectors": [
    {
      "id": "pause_blocks_request_approve_and_execute",
      "rules": ["MANDATE-PAUSE-001", "MANDATE-PAUSE-002", "MANDATE-PAUSE-003"],
      "description": "While paused, requests, approvals and execution are refused and reservations stay; after resume they work again.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": ["approver"],
          "approvals_required": 1,
          "guardians": ["guardian"],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "500",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [
          { "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } },
          { "recipient_ref": "#carol", "destination": { "address": "carol", "tag": null } }
        ],
        "mints": [{ "token": "asset", "to": "mandate", "amount": "1000" }]
      },
      "steps": [
        {
          "step": "call",
          "fn": "request_payout",
          "caller": "agent",
          "args": {
            "req": {
              "payout_id": "#p1",
              "recipient_ref": "#bob",
              "total": "600",
              "fee": "0",
              "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
              "deadline": "1767226200",
              "task_ref": "#task_p1",
              "attestations": []
            }
          },
          "expect": {
            "ok": true,
            "return": "PENDING",
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p1",
                  "agent": "agent",
                  "recipient_ref": "#bob",
                  "total": "600",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "bob", "tag": null }, "amount": "600" }],
                  "task_ref": "#task_p1",
                  "status": "PENDING",
                  "expires_at": "1767312000"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "request_payout",
          "caller": "agent",
          "args": {
            "req": {
              "payout_id": "#p2",
              "recipient_ref": "#carol",
              "total": "300",
              "fee": "0",
              "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "300" }],
              "deadline": "1767226200",
              "task_ref": "#task_p2",
              "attestations": []
            }
          },
          "expect": {
            "ok": true,
            "return": "APPROVED",
            "events": [
              {
                "name": "payout_requested",
                "fields": {
                  "payout_id": "#p2",
                  "agent": "agent",
                  "recipient_ref": "#carol",
                  "total": "300",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "300" }],
                  "task_ref": "#task_p2",
                  "status": "APPROVED",
                  "expires_at": "1767312000"
                }
              }
            ]
          }
        },
        {
          "step": "call",
          "fn": "pause",
          "caller": "guardian",
          "expect": {
            "ok": true,
            "events": [{ "name": "paused", "fields": { "by": "guardian" } }],
            "state": { "mandate": { "paused": true } }
          }
        },
        {
          "step": "call",
          "fn": "request_payout",
          "caller": "agent",
          "args": {
            "req": {
              "payout_id": "#p3",
              "recipient_ref": "#carol",
              "total": "100",
              "fee": "0",
              "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "100" }],
              "deadline": "1767226200",
              "task_ref": "#task_p3",
              "attestations": []
            }
          },
          "expect": { "error": "MANDATE_PAUSED", "events": [] }
        },
        {
          "step": "call",
          "fn": "request_payouts",
          "caller": "agent",
          "args": {
            "reqs": [
              {
                "payout_id": "#p3",
                "recipient_ref": "#carol",
                "total": "100",
                "fee": "0",
                "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "100" }],
                "deadline": "1767226200",
                "task_ref": "#task_p3",
                "attestations": []
              }
            ]
          },
          "expect": { "error": "MANDATE_PAUSED", "events": [] }
        },
        {
          "step": "call",
          "fn": "approve",
          "caller": "approver",
          "args": { "payout_id": "#p1" },
          "expect": { "error": "MANDATE_PAUSED", "events": [] }
        },
        {
          "step": "call",
          "fn": "execute",
          "caller": "agent",
          "args": { "payout_id": "#p2" },
          "expect": { "error": "MANDATE_PAUSED", "events": [] }
        },
        {
          "step": "call",
          "fn": "execute_batch",
          "caller": "agent",
          "args": { "ids": ["#p2"] },
          "expect": { "error": "MANDATE_PAUSED", "events": [] }
        },
        {
          "step": "call",
          "fn": "state",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": {
              "spent": "0",
              "pending": "600",
              "committed": "300",
              "balance": "1000",
              "free": "100",
              "paused": true,
              "revoked": false,
              "expired": false,
              "policy_epoch": "0"
            },
            "events": []
          }
        },
        {
          "step": "call",
          "fn": "resume",
          "caller": "principal",
          "expect": {
            "ok": true,
            "events": [{ "name": "resumed", "fields": { "by": "principal" } }],
            "state": { "mandate": { "paused": false } }
          }
        },
        {
          "step": "call",
          "fn": "approve",
          "caller": "approver",
          "args": { "payout_id": "#p1" },
          "expect": {
            "ok": true,
            "return": "APPROVED",
            "events": [
              {
                "name": "payout_approval_added",
                "fields": { "payout_id": "#p1", "approver": "approver", "approvals": 1, "required": 1 }
              },
              { "name": "payout_approved", "fields": { "payout_id": "#p1" } }
            ]
          }
        },
        {
          "step": "call",
          "fn": "execute",
          "caller": "agent",
          "args": { "payout_id": "#p2" },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "payout_executed",
                "fields": {
                  "payout_id": "#p2",
                  "recipient_ref": "#carol",
                  "total": "300",
                  "fee": "0",
                  "legs": [{ "destination": { "address": "carol", "tag": null }, "amount": "300" }],
                  "day": "20454",
                  "spent": "300"
                }
              }
            ],
            "state": {
              "mandate": {
                "spent": "300",
                "pending": "0",
                "committed": "600",
                "balance": "700",
                "free": "100"
              }
            }
          }
        }
      ]
    },
    {
