{
  "format": "ujira-mandate-vectors/1",
  "description": "Recovery of other tokens to the principal, never of the settlement asset.",
  "vectors": [
    {
      "id": "recover_token_pays_the_principal",
      "rules": ["MANDATE-RECOVER-001", "MANDATE-RECOVER-002", "MANDATE-RECOVER-003", "MANDATE-RECOVER-004"],
      "description": "The principal recovers another token in two parts, and the settlement balance never moves.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": ["guardian"],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [
          { "token": "asset", "to": "mandate", "amount": "1000" },
          { "token": "other_token", "to": "mandate", "amount": "500" }
        ]
      },
      "steps": [
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "other_token", "amount": "200" },
          "expect": {
            "ok": true,
            "events": [{ "name": "token_recovered", "fields": { "token": "other_token", "amount": "200" } }],
            "state": {
              "mandate": { "balance": "1000", "free": "1000" },
              "balances": {
                "other_token": { "mandate": "300", "principal": "200" },
                "asset": { "mandate": "1000", "principal": "0" }
              }
            }
          }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "other_token", "amount": "300" },
          "expect": {
            "ok": true,
            "events": [{ "name": "token_recovered", "fields": { "token": "other_token", "amount": "300" } }],
            "state": {
              "balances": {
                "other_token": { "mandate": "0", "principal": "500" },
                "asset": { "mandate": "1000", "principal": "0" }
              }
            }
          }
        }
      ]
    },
    {
      "id": "recover_token_allowed_in_every_state",
      "rules": ["MANDATE-RECOVER-003"],
      "description": "Token recovery works while paused, after expiry and after revoke.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": ["guardian"],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1767312000"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [
          { "token": "asset", "to": "mandate", "amount": "1000" },
          { "token": "other_token", "to": "mandate", "amount": "300" }
        ]
      },
      "steps": [
        {
          "step": "call",
          "fn": "pause",
          "caller": "guardian",
          "expect": { "ok": true, "events": [{ "name": "paused", "fields": { "by": "guardian" } }] }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "other_token", "amount": "100" },
          "expect": {
            "ok": true,
            "events": [{ "name": "token_recovered", "fields": { "token": "other_token", "amount": "100" } }]
          }
        },
        { "step": "set_time", "now": "1767312000" },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "other_token", "amount": "100" },
          "expect": {
            "ok": true,
            "events": [{ "name": "token_recovered", "fields": { "token": "other_token", "amount": "100" } }]
          }
        },
        {
          "step": "call",
          "fn": "revoke",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": "1000",
            "events": [{ "name": "revoked", "fields": { "by": "principal", "frozen": "1000" } }],
            "token_events": [],
            "state": { "balances": { "asset": { "mandate": "1000", "principal": "0" } } }
          }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "other_token", "amount": "100" },
          "expect": {
            "ok": true,
            "events": [{ "name": "token_recovered", "fields": { "token": "other_token", "amount": "100" } }],
            "state": {
              "balances": {
                "other_token": { "mandate": "0", "principal": "300" },
                "asset": { "mandate": "1000", "principal": "0" }
              }
            }
          }
        }
      ]
    },
    {
      "id": "recover_token_amount_and_balance_checked",
      "rules": ["MANDATE-RECOVER-001", "MANDATE-RECOVER-002", "MANDATE-RECOVER-003"],
      "description": "A zero amount is refused, the settlement asset is refused before its amount is read, and recovering more than is held fails the transfer.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_ref": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": ["guardian"],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [{ "recipient_ref": "#bob", "destination": { "address": "bob", "tag": null } }],
        "mints": [
          { "token": "asset", "to": "mandate", "amount": "1000" },
          { "token": "other_token", "to": "mandate", "amount": "500" }
        ]
      },
      "steps": [
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "other_token", "amount": "0" },
          "expect": { "error": "AMOUNT_INVALID", "events": [] }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "asset", "amount": "0" },
          "precedence": ["2", "3"],
          "expect": { "error": "WRONG_ASSET", "events": [] }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "other_token", "amount": "501" },
          "expect": { "error": "TRANSFER_FAILED", "events": [] }
        },
        {
          "step": "call",
          "fn": "state",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": {
              "spent": "0",
              "pending": "0",
              "committed": "0",
              "balance": "1000",
              "free": "1000",
              "paused": false,
              "revoked": false,
              "expired": false,
              "policy_epoch": "0"
            },
            "events": [],
            "state": { "balances": { "other_token": { "mandate": "500", "principal": "0" } } }
          }
        },
        {
          "step": "call",
          "fn": "recover_token",
          "caller": "principal",
          "args": { "token": "other_token", "amount": "500" },
          "expect": {
            "ok": true,
            "events": [{ "name": "token_recovered", "fields": { "token": "other_token", "amount": "500" } }],
            "state": { "balances": { "other_token": { "mandate": "0", "principal": "500" } } }
          }
        }
      ]
    },
