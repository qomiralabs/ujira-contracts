{
  "format": "ujira-mandate-vectors/1",
  "vectors": [
    {
      "id": "fixture_no_trustline",
      "rules": ["MANDATE-REVOKE-003"],
      "description": "A principal with no trustline cannot receive a withdrawal until it opens one.",
      "applies_to": ["stellar"],
      "skip_reason": "unrepresentable_input",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_tag": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": ["guardian"],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "500",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "mints": [{ "token": "asset", "to": "mandate", "amount": "1000" }]
      },
      "steps": [
        { "step": "set_receiving", "token": "asset", "account": "principal", "state": "no_trustline" },
        {
          "step": "call",
          "fn": "withdraw",
          "caller": "principal",
          "args": { "amount": "1000" },
          "expect": { "error": "TRANSFER_FAILED", "events": [] }
        },
        { "step": "set_receiving", "token": "asset", "account": "principal", "state": "receivable" },
        {
          "step": "call",
          "fn": "withdraw",
          "caller": "principal",
          "args": { "amount": "1000" },
          "expect": { "ok": true, "events": [{ "name": "withdrawn", "fields": { "to": "principal", "amount": "1000" } }] }
        }
      ]
    }
  ]
}
