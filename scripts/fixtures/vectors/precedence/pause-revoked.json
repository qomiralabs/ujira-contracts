{
  "format": "ujira-mandate-vectors/1",
  "vectors": [
    {
      "id": "fixture_prec_pause_revoked",
      "rules": ["MANDATE-REVOKE-002", "MANDATE-PAUSE-002"],
      "description": "A guardian pauses a mandate that is both paused and revoked.",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_tag": "#tenant",
          "agents": ["agent"],
          "approvers": [],
          "approvals_required": 0,
          "guardians": ["guardian"],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "500",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1798761600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        }
      },
      "steps": [
        {
          "step": "call",
          "fn": "pause",
          "caller": "guardian",
          "expect": { "ok": true, "events": [{ "name": "paused", "fields": { "by": "guardian" } }] }
        },
        {
          "step": "call",
          "fn": "revoke",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": "0",
            "events": [{ "name": "revoked", "fields": { "by": "principal", "frozen": "0" } }]
          }
        },
        {
          "step": "call",
          "fn": "pause",
          "caller": "guardian",
          "precedence": ["3", "4"],
          "expect": { "error": "MANDATE_REVOKED", "events": [] }
        }
      ]
    }
  ]
}
