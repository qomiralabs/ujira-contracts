    {
      "id": "chain_withdraw_and_sweep_to_a_smart_account_principal",
      "rules": [
        "MANDATE-WITHDRAW-001",
        "MANDATE-WITHDRAW-004",
        "MANDATE-SWEEP-005"
      ],
      "description": "A passkey wallet principal, which holds no trustline, withdraws and later sweeps, and the asset credits its contract balance.",
      "applies_to": [
        "stellar"
      ],
      "skip_reason": "unrepresentable_input",
      "setup": {
        "now": "1767225600",
        "actors": {
          "principal": {
            "kind": "smart_account",
            "signers": 3,
            "threshold": 2
          }
        },
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_tag": "#tenant",
          "agents": [
            "agent"
          ],
          "approvers": [],
          "approvals_required": 0,
          "guardians": [],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1767312000"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "mints": [
          {
            "token": "asset",
            "to": "mandate",
            "amount": "1000"
          }
        ]
      },
      "steps": [
        {
          "step": "call",
          "fn": "withdraw",
          "caller": "principal",
          "args": {
            "amount": "300"
          },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "withdrawn",
                "fields": {
                  "to": "principal",
                  "amount": "300"
                }
              }
            ],
            "state": {
              "balances": {
                "asset": {
                  "mandate": "700",
                  "principal": "300"
                }
              }
            }
          }
        },
        {
          "step": "set_time",
          "now": "1767312000"
        },
        {
          "step": "call",
          "fn": "sweep",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": "700",
            "events": [
              {
                "name": "swept",
                "fields": {
                  "by": "principal",
                  "amount": "700"
                }
              }
            ],
            "state": {
              "balances": {
                "asset": {
                  "mandate": "0",
                  "principal": "1000"
                }
              }
            }
          }
        }
      ]
    },
