{
  "format": "ujira-mandate-vectors/1",
  "description": "Stellar only cases that sit beside the shared vectors: they need the compiled factory and mandate and run under cargo test -p vector-runner chain_specific.",
  "vectors": [
    {
      "id": "chain_revoke_without_trustline_moves_nothing",
      "rules": [
        "MANDATE-REVOKE-001",
        "MANDATE-REVOKE-003"
      ],
      "description": "A principal with no trustline revokes with no transfer, cannot withdraw, and withdraws once it has a trustline.",
      "applies_to": [
        "stellar"
      ],
      "skip_reason": "unrepresentable_input",
      "setup": {
        "now": "1767225600",
        "mandate": {
          "principal": "principal",
          "asset": "asset",
          "recipient_mode": "ALLOWLIST",
          "tenant_tag": "#tenant",
          "agents": [
            "agent"
          ],
          "approvers": [],
          "approvals_required": 0,
          "guardians": [
            "guardian"
          ],
          "executors": [],
          "recovery": [],
          "recovery_threshold": 0,
          "limits": {
            "total_budget": "10000",
            "per_payment_cap": "1000",
            "per_recipient_daily_cap": "1000",
            "approval_threshold": "1001",
            "payout_ttl_seconds": "86400",
            "expires_at": "1830297600"
          },
          "attester": null,
          "country_policy_hash": "#no_countries",
          "max_fee_bps": 0
        },
        "allowlist": [
          {
            "recipient_ref": "#bob",
            "destination": {
              "address": "bob",
              "tag": null
            }
          },
          {
            "recipient_ref": "#bob",
            "destination": {
              "address": "carol",
              "tag": null
            }
          }
        ],
        "mints": [
          {
            "token": "asset",
            "to": "mandate",
            "amount": "1000"
          }
        ]
      },
      "steps": [
        {
          "step": "set_receiving",
          "token": "asset",
          "account": "principal",
          "state": "no_trustline"
        },
        {
          "step": "call",
          "fn": "revoke",
          "caller": "principal",
          "expect": {
            "ok": true,
            "return": "1000",
            "events": [
              {
                "name": "revoked",
                "fields": {
                  "by": "principal",
                  "frozen": "1000"
                }
              }
            ],
            "token_events": [],
            "state": {
              "mandate": {
                "revoked": true,
                "balance": "1000"
              },
              "balances": {
                "asset": {
                  "mandate": "1000",
                  "principal": "0"
                }
              }
            }
          }
        },
        {
          "step": "call",
          "fn": "withdraw",
          "caller": "principal",
          "args": {
            "amount": "1000"
          },
          "expect": {
            "error": "TRANSFER_FAILED",
            "events": []
          }
        },
        {
          "step": "set_receiving",
          "token": "asset",
          "account": "principal",
          "state": "receivable"
        },
        {
          "step": "call",
          "fn": "withdraw",
          "caller": "principal",
          "args": {
            "amount": "1000"
          },
          "expect": {
            "ok": true,
            "events": [
              {
                "name": "withdrawn",
                "fields": {
                  "to": "principal",
                  "amount": "1000"
                }
              }
            ],
            "state": {
              "balances": {
                "asset": {
                  "mandate": "0",
                  "principal": "1000"
                }
              }
            }
          }
        }
      ]
    },
